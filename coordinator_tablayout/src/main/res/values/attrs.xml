<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="CoordinatorTabLayout">
        <!-- Tab indicator customization -->
        <attr name="tabIndicatorColor" format="color" />
        <attr name="tabIndicatorHeight" format="dimension" />

        <!-- Tab text colors -->
        <attr name="tabTextColor" format="color" />
        <attr name="tabSelectedTextColor" format="color" />
        <attr name="tabTextSize" format="dimension" />

        <!-- Toolbar colors -->
        <attr name="contentScrimColor" format="color" />
        <attr name="expandedTitleColor" format="color" />
        <attr name="collapsedTitleColor" format="color" />

        <!-- Content customization -->
        <attr name="contentBackgroundColor" format="color" />

        <!-- Dimensions -->
        <attr name="toolbarHeight" format="dimension" />
    </declare-styleable>
</resources>